@article{mastersRaschModelPartial1982,
	title = {A rasch model for partial credit scoring},
	volume = {47},
	issn = {1860-0980},
	url = {https://doi.org/10.1007/BF02296272},
	doi = {10.1007/BF02296272},
	abstract = {A unidimensional latent trait model for responses scored in two or more ordered categories is developed. This “Partial Credit” model is a member of the family of latent trait models which share the property of parameter separability and so permit “specifically objective” comparisons of persons and items. The model can be viewed as an extension of Andrich's Rating Scale model to situations in which ordered response alternatives are free to vary in number and structure from item to item. The difference between the parameters in this model and the “category boundaries” in Samejima's Graded Response model is demonstrated. An unconditional maximum likelihood procedure for estimating the model parameters is developed.},
	pages = {149--174},
	number = {2},
	journaltitle = {Psychometrika},
	shortjournal = {Psychometrika},
	author = {Masters, Geoff N.},
	urldate = {2026-09-20},
	date = {1982-06-01},
	langid = {english},
	keywords = {Rasch model, latent trait, ordered categories, partial credit},
	file = {Full Text PDF:C\:\\Users\\5897091\\Zotero\\storage\\8NPPIDUV\\Masters - 1982 - A rasch model for partial credit scoring.pdf:application/pdf},
}

@article{andersenSufficientStatisticsLatent1977,
	title = {Sufficient statistics and latent trait models},
	volume = {42},
	issn = {1860-0980},
	url = {https://doi.org/10.1007/BF02293746},
	doi = {10.1007/BF02293746},
	abstract = {For questionnaires with two answer categories, it has been proven in complete generality that if a minimal sufficient statistic exists for the individual parameter and if it is the same statistic for all values of the item parameters, then the raw score (or the number of correct answers) is the minimal sufficient statistic. It follows that the model must by of the Rasch type with logistic item characteristic curves and equal item-discriminating powers.},
	pages = {69--81},
	number = {1},
	journaltitle = {Psychometrika},
	shortjournal = {Psychometrika},
	author = {Andersen, Erling B.},
	urldate = {2026-09-20},
	date = {1977-03-01},
	langid = {english},
	keywords = {equidistant scoring, logistic latent trait, minimal sufficient statistic, Rasch model, sufficiency},
	file = {Full Text PDF:C\:\\Users\\5897091\\Zotero\\storage\\8UCSNTQK\\Andersen - 1977 - Sufficient statistics and latent trait models.pdf:application/pdf},
}

